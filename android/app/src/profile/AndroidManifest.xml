<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!--  The INTERNET permission is required for development. Specifically,
             the Flutter tool needs it to communicate with the running application
             to allow setting breakpoints, to provide hot reload, etc.
         -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!--  DEBUG / PROFILE ONLY: let "flutter run" find a launch screen.  -->
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!--  ...and switch the default alias off, so only ONE icon shows.  -->
        <activity-alias android:name=".IconDefault" android:enabled="false" tools:replace="android:enabled"/>
    </application>
</manifest>